# Environment example for Bridal-Salon-Copy
# Copy to SERVER/.env (or create .env.local) and fill values — do NOT commit secrets.

# Email (nodemailer) — for Gmail use App Passwords
EMAIL_USER=
EMAIL_PASS=

# Database
DB_HOST=localhost
DB_USER=root
DB_NAME=mysql_project
DB_PORT=3306
DB_PASSWORD=

# JWT secrets
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# Client API URL (used by client via Vite)
VITE_API_URL=http://localhost:3000
